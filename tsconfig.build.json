{
	"extends": "./tsconfig.app.json",
	"compilerOptions": {
		"noEmit": false,
		"emitDeclarationOnly": true,
		"declaration": true,
		"declarationMap": true,
		"outDir": "dist",
		"rootDir": "src",
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.build.tsbuildinfo"
	},
	"include": [
		"src/components/lightweight-charts/TChart.tsx",
		"src/components/adachart/AdaChart.tsx",
		"src/components/klinecharts-pro/KChartPro.tsx",
		"src/components/lightweight-charts-pro/TChartPro.tsx",
		"src/components/adachart-pro/AdaChartPro.tsx"
	],
	"exclude": [
		"src/**/*.stories.tsx",
		"src/**/*.test.ts",
		"src/**/__data__/**/*"
	]
}
